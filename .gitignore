# ==============================================================================
# Unified TRUSTMED .gitignore (Single Root Location)
# ==============================================================================

# 1. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 2. Python & Bytecode
__pycache__/
*.py[cod]
*.pyc
*.pyo
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg

# 3. Environment Variables & Secrets
.env
.env.*
!.env.example

# 4. Jupyter Notebooks & Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# 5. Datasets & Raw Large Data Archives
data/
*.zip
*.tar.gz
*.tar
*.rar
*.7z

# 6. Frontend & Node.js Dependencies
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/
*.local

# 7. Testing & Quality Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# 8. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 9. IDE, Editors & OS Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
